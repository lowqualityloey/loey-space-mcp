{
  "name": "loey-space-mcp",
  "version": "1.0.0",
  "description": "Hardened, read-only MCP server for loey_space with kernel-locked canonical milestone logging",
  "bin": {
    "loey-space-mcp": "./bin/loey-space-mcp"
  },
  "files": [
    "bin/",
    "src/",
    "canonical/",
    "clients/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install:cli": "node tools/install-cli.mjs",
    "test": "node --test test/test-safe-mcp.mjs",
    "test:integration": "node --test test/test-integration.mjs",
    "test:install": "node --test test/test-install-cli.mjs",
    "test:hook": "node --test test/test-install-hook.mjs",
    "test:escaping": "node --test test/test-escaping-dedupe.mjs",
    "test:search": "node --test test/test-search-engine.mjs",
    "test:migrate": "node --test test/test-migrate-log.mjs",
    "test:all": "node --test test/test-safe-mcp.mjs test/test-integration.mjs test/test-install-cli.mjs test/test-install-hook.mjs test/test-escaping-dedupe.mjs test/test-search-engine.mjs test/test-migrate-log.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "second-brain"
  ],
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowqualityloey/loey-space-mcp.git"
  },
  "homepage": "https://github.com/lowqualityloey/loey-space-mcp#readme",
  "bugs": {
    "url": "https://github.com/lowqualityloey/loey-space-mcp/issues"
  },
  "license": "MIT"
}
