#!/usr/bin/env bash
set -euo pipefail

# Resolve physical path even if invoked via symlink in ~/.local/bin
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Informational flags only. Roots and arbitrary flags stay refused: the vault is fixed
# by LOEY_VAULT_ROOT, and this interface must never accept a second root.
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'USAGE'
loey-space-mcp - hardened, read-only MCP server for loey_space notes

Usage: loey-space-mcp [--help] [--version]

With no arguments it starts the stdio MCP server. The vault root must be supplied
as an absolute LOEY_VAULT_ROOT (see README).
USAGE
  exit 0
fi

# Discover Node binary
if [ -n "${NODE_BIN:-}" ] && [ -x "$NODE_BIN" ]; then
  NODE_EXEC="$NODE_BIN"
else
  NODE_EXEC="$(command -v node 2>/dev/null || true)"
fi

if [ -z "$NODE_EXEC" ] || [ ! -x "$NODE_EXEC" ]; then
  echo "loey-space-mcp: node executable not found in PATH" >&2
  exit 1
fi

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
  "$NODE_EXEC" -e "process.stdout.write(require(process.argv[1]).version + '\n')" "$SCRIPT_DIR/package.json"
  exit 0
fi

if [ "$#" -ne 0 ]; then
  echo "loey-space-mcp: this external-agent interface accepts no extra roots or flags" >&2
  exit 2
fi

# Require explicit, absolute vault root
if [ -z "${LOEY_VAULT_ROOT:-}" ]; then
  echo "loey-space-mcp: LOEY_VAULT_ROOT is required but was not set or is empty" >&2
  exit 1
fi

if [[ "$LOEY_VAULT_ROOT" != /* ]]; then
  echo "loey-space-mcp: LOEY_VAULT_ROOT must be an absolute path: $LOEY_VAULT_ROOT" >&2
  exit 1
fi

# Default canonical CLI to package-relative bundled implementation if unset
export LOEY_CLI_PATH="${LOEY_CLI_PATH:-$SCRIPT_DIR/canonical/heyloey.cjs}"

exec "$NODE_EXEC" "$SCRIPT_DIR/src/safe-mcp.mjs"
