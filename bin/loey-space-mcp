#!/bin/bash
set -eu
if [ -x "/home/heyloey/.nvm/versions/node/v24.22.0/bin/node" ]; then
  NODE_BIN="/home/heyloey/.nvm/versions/node/v24.22.0/bin/node"
else
  NODE_BIN="$(command -v node)"
fi
if [ "$#" -ne 0 ]; then
  echo "loey-space-mcp: this external-agent interface accepts no extra roots or flags" >&2
  exit 2
fi
exec "$NODE_BIN" "/home/heyloey/.local/share/loey-space-mcp/safe-mcp.mjs"
